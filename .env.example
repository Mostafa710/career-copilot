# ==============================================================================
# Career Copilot Configuration (.env)
# Copy this file to .env and provide your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider (Groq with Multi-Key Round-Robin Rotation)
# ------------------------------------------------------------------------------
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_API_KEY_4=your_groq_api_key_4_here
GROQ_MODEL=openai/gpt-oss-120b
# Alternative fast model: GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 3. Vector Embeddings (100% Free Local HuggingFace on CPU - AWS Free Tier Ready)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# (Optional: If you prefer OpenAI, set EMBEDDING_PROVIDER=openai and supply key)
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 4. Job Search & Web Intelligence APIs
# ------------------------------------------------------------------------------
# RapidAPI JSearch (Free tier at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# Queries live LinkedIn & Indeed listings for Egypt, MENA, and international
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com

# Tavily Search API (Free registration at https://tavily.com/)
TAVILY_API_KEY=tvly-your_tavily_api_key

# ------------------------------------------------------------------------------
# 5. Database (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/career_copilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 6. Observability (LangSmith)
# ------------------------------------------------------------------------------
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_your_langsmith_api_key
LANGCHAIN_PROJECT=career-copilot
LANGCHAIN_TRACING_V2=true

# ------------------------------------------------------------------------------
# 7. Security & App Settings
# ------------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-32-byte-string-for-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=10080
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage
